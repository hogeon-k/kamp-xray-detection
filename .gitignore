# Ultralytics default runs
runs/

# Project generated outputs, including clean datasets, audits and training artifacts
outputs/*

# Keep the small, reusable YOLO dataset configuration and its documentation
!outputs/yolo_poc_20/
outputs/yolo_poc_20/*
!outputs/yolo_poc_20/dataset.yaml
!outputs/yolo_poc_20/README.md

# Keep only the cross-experiment summary; individual runs stay ignored
!outputs/yolo_runs/
outputs/yolo_runs/*
!outputs/yolo_runs/experiments.csv

# Temporary / cache
tmp/
temp/
cache/
.cache/

# Logs
*.log

# Large archives
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Generated submission package (copies sources, datasets and model artifacts)
/KAMP_Xray_Submission/

# Exported presentation files
/presentation/
/KAMP_Xray_Presentation.pdf

# Presentation build artifacts; keep reusable build scripts and input specs
/presentation_build/*
!/presentation_build/*.py
!/presentation_build/*.js
!/presentation_build/*.mjs
!/presentation_build/slides.json
!/presentation_build/*_specs.json
!/presentation_build/*_inputs.json
!/presentation_build/package.json
!/presentation_build/package-lock.json

# Audit outputs; keep the scripts used to reproduce the checks
/report_audit/*
!/report_audit/*.py
/submission_audit/*
!/submission_audit/*.py
/verification.json

# JavaScript dependencies and local temporary files
node_modules/
*.tsbuildinfo
~$*
*.tmp
*.bak
